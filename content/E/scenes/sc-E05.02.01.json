 "facts": [
  {
   "text": "Prenotochordal cells enter at the primitive node and move straight forward in the midline up to the prechordal plate.",
   "cite": "E05.02 · R05a, R06 CS7",
   "mark": "✔✔"
  },
  {
   "text": "For a short time they sit within the endoderm layer as the notochordal plate.",
   "cite": "E05.02 · R05a",
   "mark": "✔✔"
  },
  {
   "text": "The plate then lifts off the endoderm and rolls into a solid rod, the definitive notochord.",
   "cite": "E05.02 · R05a",
   "mark": "✔✔"
  },
  {
   "text": "The book has the head end of the notochord forming first, by about day 17, with tail parts added as the streak moves back; this scene follows the book.",
   "cite": "E05.02 · R05a (D-029)",
   "mark": "⚑"
  },
  {
   "text": "Newer evidence: in human embryos the finished rod first appears mid-body and grows both ways, at stages 11–12 (about days 23–30); not animated here.",
   "cite": "E05.02 · R05a (D-029)",
   "mark": "⚑"
  },
  {
   "text": "CS07 (days 16–18): ≈0.4 mm. The book's 18-day embryo, already CS08: ≈1.25 mm.",
   "cite": "E06.06 Tbl 6.4, E06.01 Fig 6.1 · R06, R08",
   "mark": "✔✔"
  }
 ],
