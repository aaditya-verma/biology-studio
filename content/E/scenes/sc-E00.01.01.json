 "facts": [
  {
   "text": "The primitive streak first shows in the caudal midline of the disc; its cranial end is the primitive node.",
   "cite": "E05.01 · R06 CS6, CS8",
   "mark": "✔✔"
  },
  {
   "text": "The streak marks the long axis: it lies at the caudal end, and the head (cranial) end is opposite it.",
   "cite": "E05.01, E05.03",
   "mark": "✔"
  },
  {
   "text": "The head–tail and back–belly axes are already set before the streak appears.",
   "cite": "E05.03",
   "mark": "✔"
  },
  {
   "text": "Dorsal = the epiblast side, facing the amniotic cavity; ventral = the hypoblast side, facing the yolk sac.",
   "cite": "E04.01, E04.04 · R06 CS6",
   "mark": "✔✔"
  }
 ],
