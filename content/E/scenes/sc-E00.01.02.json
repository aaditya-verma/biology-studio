 "facts": [
  {
   "text": "The book dates embryos in days after fertilization; Carnegie stages group embryos by their form, so a stage spans a few days.",
   "cite": "E06.06 Tbl 6.4 · R05f, R06",
   "mark": "✔✔"
  },
  {
   "text": "CS06 (days 14–15): ≈0.2 mm. CS07 (days 16–18): ≈0.4 mm. The book's 18-day embryo, already CS08: ≈1.25 mm.",
   "cite": "E06.06 Tbl 6.4, E06.01 Fig 6.1 · R06, R08",
   "mark": "✔✔"
  },
  {
   "text": "Newer evidence gives some stages older ages than the book's table; we show the book's days.",
   "cite": "E06.06 · R02, R05f (D-030)",
   "mark": "⚑"
  },
  {
   "text": "The near-round disc becomes pear-shaped — broad at the head end, narrow at the tail end.",
   "cite": "E05.05 · R06 CS8, R02 CS8",
   "mark": "✔✔"
  },
  {
   "text": "Most growth is at the head end; the streak region stays about the same size.",
   "cite": "E05.05",
   "mark": "✔"
  }
 ],
