 "facts": [
  {
   "text": "Gastrulation turns the two-layer disc into the three germ layers: ectoderm, mesoderm and endoderm.",
   "cite": "E05.01 · R05b",
   "mark": "✔✔"
  },
  {
   "text": "The primitive streak first shows in the caudal midline of the disc; its cranial end is the primitive node.",
   "cite": "E05.01 · R06 CS6, CS8",
   "mark": "✔✔"
  },
  {
   "text": "Epiblast cells move to the streak, detach and slip beneath the epiblast (invagination).",
   "cite": "E05.01",
   "mark": "✔"
  },
  {
   "text": "The first cells in replace the hypoblast and become endoderm.",
   "cite": "E05.01",
   "mark": "✔"
  },
  {
   "text": "Later cells settle between the two layers as mesoderm and spread sideways and toward the head.",
   "cite": "E05.01",
   "mark": "✔"
  },
  {
   "text": "Cells that stay in the epiblast become ectoderm — so all three layers come from the epiblast.",
   "cite": "E05.01, E05.07",
   "mark": "✔"
  }
 ],
